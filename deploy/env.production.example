# =====================================================================
#  Golden Pos - modèle de fichier .env pour le poste serveur du magasin
#  Copier en ".env" à la racine du projet, puis compléter les valeurs vides.
#  Ne jamais versionner le fichier .env réel (mots de passe).
# =====================================================================
APP_NAME="Golden Pos"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://golden-pos.local:8080
APP_TIMEZONE=Africa/Tunis

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

# Journaux : un fichier par jour, 30 jours conservés, avertissements et erreurs seulement
LOG_CHANNEL=daily
LOG_STACK=daily
LOG_DAILY_DAYS=30
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# Base PostgreSQL partagée avec le logiciel de bureau
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=velaro
DB_USERNAME=postgres
DB_PASSWORD=
DB_TIMEZONE=Africa/Tunis
# Connexion persistante : indispensable si la base est sur un autre poste ou un serveur distant
# (évite environ 200 ms d'ouverture de connexion à chaque page). Chaque fil Apache garde au plus
# une connexion : limiter les fils (ThreadsPerChild, voir deploy/apache/golden-pos.conf) pour
# rester sous max_connections de PostgreSQL (100 par défaut), le logiciel de bureau compris.
DB_PERSISTENT=true

# Sessions et cache sur fichiers (pas de table Laravel supplémentaire nécessaire)
SESSION_DRIVER=file
SESSION_LIFETIME=480
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=file

MAIL_MAILER=log

# Bip SMS (les valeurs saisies dans Paramètres > Général l'emportent)
BIPSMS_KEY=
BIPSMS_SENDER=GOLDENPOS
BIPSMS_URL=http://bulksms.bipsms.tn/Api/Api.aspx

# Caisse : identifiant du client PASSAGER (vente comptoir)
POS_CLIENT_PASSAGER_ID=1
